# Postgres 連線字串。本機開發用 Docker；正式環境用 Neon（記得 ?sslmode=require）
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/pmtracker"

# `openssl rand -base64 32` 產生
AUTH_SECRET=""

# Google OAuth client（redirect URI: <your-domain>/api/auth/callback/google）
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 開發用快速登入（1=啟用）。正式環境設 0。
ALLOW_DEV_LOGIN="0"

# 每日到期提醒 cron 的密鑰（Vercel Cron 會帶 Authorization: Bearer <CRON_SECRET>）。
CRON_SECRET=""

# ── Web Push（桌面通知，關網頁也能收）──────────────────────────
# 用 `bunx web-push generate-vapid-keys` 產生一組。未設定時推播靜默停用（只留站內鈴鐺）。
# 這四個都要設（VAPID_PUBLIC_KEY 與 NEXT_PUBLIC_VAPID_PUBLIC_KEY 填同一把公鑰）。
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ── Google Gemini（CRM 名片 OCR）────────────────────────────────
# 免費金鑰：https://aistudio.google.com/apikey。未設定時「上傳名片」只存照片，
# 不會自動辨識填表（UI 也不會顯示辨識相關按鈕）。
GOOGLE_API_KEY=""
# CRM_CARD_OCR_MODEL="gemini-2.5-flash"
