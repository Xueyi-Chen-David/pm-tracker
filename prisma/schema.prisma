// Project tracker — Prisma schema (Postgres + driver adapter, Prisma 7)
// 本機開發用 Docker Postgres；正式環境把 DATABASE_URL 換成 Neon 即可。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Auth.js (NextAuth v5) — Prisma adapter, database sessions
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String? // 真實姓名
  nickname      String? // 綽號 / 暱稱
  useNickname   Boolean   @default(false) // 顯示時用綽號取代真實姓名
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  // 註：組織內欄位（isBoss / jobTitle / 權限 / 出席追蹤 / profile 文字）已改掛在
  // OrganizationMember 上，讓同一人可在不同組織有不同角色與設定（多租戶隔離）。

  accounts Account[]
  sessions Session[]

  // 組織成員資格（多組織）。
  organizationMemberships OrganizationMember[]

  ownedProjects     Project[]          @relation("ProjectOwner")
  createdProjects   Project[]          @relation("ProjectCreator")
  weeklyUpdates     WeeklyUpdate[]
  activities        Activity[]
  memberEvents      MemberEvent[]
  weeklyTasks       WeeklyTask[]
  attendanceRecords AttendanceRecord[]
  objectivesOwned   Objective[]        @relation("ObjectiveOwner")
  keyResultsOwned   KeyResult[]        @relation("KrOwners")
  tasksOwned        Task[]             @relation("TaskOwners")
  tasksPrimaryOwned Task[]             @relation("TaskPrimaryOwner")

  dailyReports         DailyReport[]
  dailyReportComments  DailyReportComment[]
  dailyReportReactions DailyReportReaction[]
  notifications        Notification[]
  checkIns             CheckIn[]
  checkInCorrections   CheckInCorrection[]
  trainingAssignments  TrainingAssignment[]
  crmContactsOwned     CrmContact[]          @relation("CrmContactOwner")
  crmDealsOwned        CrmDeal[]             @relation("CrmDealOwner")
  crmDealOwnerships    CrmDealOwner[]        @relation("CrmDealOwnerMember")
  todoItems            TodoItem[]
  pomodoroSessions     PomodoroSession[]
  leaveRequests        LeaveRequest[]
  pushSubscriptions    PushSubscription[]
  emailChangeRequests  EmailChangeRequest[]
}

/// 變更「某個組織」使用之 Email 的待驗證請求：寄驗證連結到新信箱，驗證後只更新該組織的
/// OrganizationMember.email（不動全域登入身分 User.email，也不影響此人的其他組織）。
model EmailChangeRequest {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String // 要變更的是「這個組織」的 email
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  newEmail       String // 目標新信箱（小寫）
  token          String       @unique // 驗證連結的密鑰
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([organizationId])
}

/// 瀏覽器推播訂閱（每個裝置 / 瀏覽器一筆）。用來在關閉網頁時也能發桌面通知。
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String // 加密公鑰
  auth      String // 加密驗證秘密
  userAgent String? // 裝置 / 瀏覽器（顯示用）
  createdAt DateTime @default(now())

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// Organizations (多租戶：以「組織 / 公司」為單位)
// ─────────────────────────────────────────────

enum OrgRole {
  OWNER // 擁有者（建立者）
  ADMIN // 管理員（可管理成員）
  MEMBER // 一般成員
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 公司營運頁：組織願景（Vision）。策略層 OKR（年度 / 季度 Objective）掛在下面。
  vision String? @db.Text

  // 每日報告：上級的上級（直屬主管以上的整條鏈）是否也看得到下屬日報。
  // false＝只有直屬主管看得到；true＝整條上級鏈都看得到。由管理者設定。
  dailyReportChainVisible Boolean @default(false)

  // 打卡限制設定（管理者設定）。啟用後，員工需符合「允許 IP」與「地理圍欄」的組合才算有效打卡。
  checkInEnabled    Boolean  @default(false)
  checkInAllowedIps String[] @default([]) // 允許的 IP / CIDR 網段（清單內任一符合即算「網段通過」）
  checkInGeofences  Json? // [{ label, lat, lng, radiusM }]（清單內任一範圍內即算「地點通過」）
  // 網段與地點的組合方式："any"＝任一符合即可（IP 或 地點）；"all"＝兩者皆須符合（IP 且 地點）。
  // 只設定其中一種條件時，兩種模式行為相同（只需該條件通過）。
  checkInMatchMode  String   @default("any")

  // Google 日曆同步（請假 / 出差核准後自動寫入一筆全天事件）：要同步進去的日曆 ID。
  // 管理者需自行把這顆日曆分享給服務帳戶「進行變更」權限。留空＝不同步。
  googleCalendarId String?

  // 進階：組織自訂 Google 服務帳戶。多租戶下所有組織預設共用系統的服務帳戶（env
  // GOOGLE_CALENDAR_CLIENT_EMAIL/_PRIVATE_KEY），組織可以改用自己建立的服務帳戶覆寫，
  // 兩個欄位都有值才生效；私鑰用 src/server/encryption.ts 的 AES-256-GCM 加密存放，
  // 不是明文。
  googleCalendarClientEmail         String?
  googleCalendarPrivateKeyEncrypted String? @db.Text

  // 進階：模擬使用者（網域範圍委派 / domain-wide delegation）。KORVVA 案例證實：服務帳戶
  // 就算直接分享到日曆 ACL、角色也確實是 writer，只要目標日曆屬於 Google Workspace 網域，
  // 實際寫入還是會被 403 擋下——Google 官方文件講得很清楚，網域擁有的日曆只認網域範圍
  // 委派，不認直接 ACL 分享這條路（跟 GCP 專案是誰的、換幾把金鑰都無關）。設定這個欄位
  // 後，JWT 會多帶 sub claim，服務帳戶等於「變身」成這個使用者操作，不再需要日曆 ACL
  // 分享；該使用者需要網域管理員先在 Admin 控制台「安全性 → API 控制項 → 網域範圍
  // 委派」把服務帳戶的用戶端 ID 授權 https://www.googleapis.com/auth/calendar 範圍。
  googleCalendarImpersonateUser String?

  // AI（Gemini）：組織自備的 API key。平台不提供預設 key——沒設定就不開 AI 功能。
  // 用 src/server/encryption.ts 的 AES-256-GCM 加密存放；末四碼另存明文只供畫面辨識。
  geminiApiKeyEncrypted String? @db.Text
  geminiApiKeyLast4     String?

  members              OrganizationMember[]
  emailChangeRequests  EmailChangeRequest[]
  projects             Project[]
  projectViews         ProjectView[]
  weeklyReports        WeeklyReport[]
  reportImages         ReportImage[]
  meetings             Meeting[]
  attendanceRecords    AttendanceRecord[]
  memberEvents         MemberEvent[]
  objectives           Objective[]
  dailyReports         DailyReport[]
  notifications        Notification[]
  checkIns             CheckIn[]
  checkInCorrections   CheckInCorrection[]
  trainingCourses      TrainingCourse[]
  trainingAssignments  TrainingAssignment[]
  trainingDocFolders   TrainingDocFolder[]
  trainingDocPages     TrainingDocPage[]
  crmContacts          CrmContact[]
  crmDeals             CrmDeal[]
  dealStages           DealStage[]
  dealStageChanges     DealStageChange[]
  crmEvents            CrmEvent[]
  crmCompanyNotes      CrmCompanyNote[]
  crmCompanyProfiles   CrmCompanyProfile[]
  crmViews             CrmView[]
  todoItems            TodoItem[]
  pomodoroSessions     PomodoroSession[]
  // 人資：自訂角色 / 假別 / 薪資設定 / 薪資單。
  roleDefs             OrgRoleDef[]
  leaveTypes           LeaveType[]
  salaryProfiles       SalaryProfile[]
  payslips             Payslip[]
  leaveApprovalSteps   LeaveApprovalStep[]
  leaveRequests        LeaveRequest[]
  payrollSetting       PayrollSetting?
  insuranceBrackets    InsuranceBracket[]
  salaryItemDefs       SalaryItemDef[]
  payslipAdjustments   PayslipAdjustment[]
  // 應用程式（模組）安裝狀態，與各模組自己的資料。
  modules              OrganizationModule[]
  foodLabelProducts    FoodLabelProduct[]
  foodLabelConversions FoodLabelConversion[]
  holidays             OrgHoliday[]
  aiUsages             AiUsage[]
  okrPeriods           OkrPeriod[]
}

/**
 * 組織成員。以 email 為邀請鍵（可在該人登入前先建立），userId 連到全域 User。
 * 「組織內」欄位（角色 / 職稱 / 老闆 / 權限 / 出席追蹤 / 團隊 profile）都掛在這裡，
 * 讓同一人在不同組織可有不同設定。
 */
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String // 邀請鍵（小寫）＝該 User 的 email
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(MEMBER)

  // ── 從 User 搬過來的「組織內」欄位 ──
  jobTitle        String? // 職稱（顯示用）
  department      String? // 部門（顯示 / 分組用；組織架構頁可就地設定）
  hireDate        DateTime? @db.Date // 到職日：特休年資（勞基法§38）與年資顯示用
  resignDate      DateTime? @db.Date // 離職日：僅供人資記錄，不會自動變更下方的 active（在職）欄位
  isBoss          Boolean   @default(false) // 老闆：週報「需要決策」收件對象
  active          Boolean   @default(true) // 是否在職 / 啟用（於此組織）
  allowedModules  String[]  @default([]) // 細分權限：空陣列＝可見全部；非空＝只可見列出的模組
  trackAttendance Boolean   @default(false) // 是否納入出席月曆追蹤
  bio             String?   @db.Text // 簡介 / 備註
  attendance      String? // 出席情況（自由文字）
  workDescription String?   @db.Text // 工作描述（本人可改，管理者可改任何人的）

  // 組織架構：上級主管（指向同組織的另一位成員）。主管可看下屬的每日報告。
  managerId String?
  manager   OrganizationMember?  @relation("MemberManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   OrganizationMember[] @relation("MemberManager")

  // 額外（虛線 / 矩陣式）回報對象：除 managerId 外，也回報給這些成員（值＝membership id）。
  // 這些人與正式上級主管一樣，可在每日報告看到並回饋這位成員的日報，但可見性不沿其
  // 自身主管鏈往上傳遞。純 id 陣列（無 FK）；成員被移除時由 deleteWorkspaceMember 清掉殘留 id。
  secondaryManagerIds String[] @default([])
  // 免簽核：這位成員送出的請假一律直接核准，跳過組織設定的簽核關卡（他當其他人的簽核人不受影響）。
  leaveApprovalExempt Boolean  @default(false)
  // 免打卡：不需要打卡的成員（如老闆、外勤、兼職顧問）。不跳「忘了打卡」提醒，出勤月曆也不自動標「未打卡」缺席；
  // 仍可自行打卡，打了照常記錄與計算工時。
  checkInExempt       Boolean  @default(false)

  // 人資：指派的自訂角色（多對多，如 人資 / 會計）；權限取聯集。刪除角色時自動解除指派。
  roleDefs           OrgRoleDef[]        @relation("MemberRoles")
  // 人資：薪資設定（每位成員一份）與歷月薪資單。
  salaryProfile      SalaryProfile?
  payslips           Payslip[]
  // 當月一次性獎金 / 調整（三節 / 臨時 / 年終…；不進常駐薪資設定，僅影響指定月份）。
  payslipAdjustments PayslipAdjustment[]

  // 請假簽核：作為簽核關卡的指定簽核人 / 作為申請人 / 作為某申請某關的實際簽核人。
  leaveStepApprovals   LeaveApprovalStep[]   @relation("LeaveStepApprover")
  leaveRequests        LeaveRequest[]        @relation("LeaveRequestMember")
  leaveApprovals       LeaveApproval[]       @relation("LeaveApprovalApprover")
  // 出差 / 事件簽核：沿用同一組簽核關卡設定，作為某事件某關的實際簽核人。
  memberEventApprovals MemberEventApproval[] @relation("MemberEventApprovalApprover")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([managerId])
}

// ─────────────────────────────────────────────
// Domain models
// ─────────────────────────────────────────────

enum ProjectType {
  ROUTINE // 常態型任務
  PROJECT // 專案型任務
  ONE_TIME // 一次型任務
}

enum ProjectStatus {
  NOT_STARTED // 未開始
  ACTIVE // 進行中
  ON_HOLD // 暫停
  COMPLETED // 已完成
  CANCELLED // 已取消
}

// RAG 紅黃綠燈 — 一眼看出問題（業界週報慣例）
enum Health {
  GREEN // 順利
  YELLOW // 需注意
  RED // 有阻礙/落後
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MilestoneStatus {
  PLANNED // 規劃中
  IN_PROGRESS // 進行中
  DONE // 已完成
  MISSED // 已逾期/未達成
}

model Project {
  id          String        @id @default(cuid())
  name        String
  type        ProjectType   @default(PROJECT)
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  health      Health        @default(GREEN) // 目前健康度（可由最新週報帶入）
  priority    Priority      @default(MEDIUM)

  startDate     DateTime? // 開始日
  targetDate    DateTime? // 理想完成日（planned）
  actualEndDate DateTime? // 實際完成日（切換成「已完成」的當下；離開已完成時清空）

  // 目前 status 是「何時切換成現值」的時間戳。用於卡片一眼看出「何時完成 / 暫停 / 取消」，
  // 以及「已在此狀態 N 天」。每次狀態實際變動時由 server action 更新（含建立當下）。
  statusChangedAt DateTime?

  progress  Int     @default(0) // 目前整體進度 0-100
  color     String? // timeline / 標籤顏色（hex）
  archived  Boolean @default(false)
  sortOrder Int     @default(0)

  countInProgress Boolean @default(true) // 是否計入週報「完成度」統計（整體平均進度）

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id])

  createdById String
  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id])

  weeklyUpdates WeeklyUpdate[]
  milestones    Milestone[]
  releases      ProjectRelease[]
  activities    Activity[]
  keyResults    KeyResult[]      @relation("KrProject")
  tasks         Task[]           @relation("ProjectTask")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([status])
}

model WeeklyUpdate {
  id        String   @id @default(cuid())
  projectId String
  weekStart DateTime @db.Date // 該週週一（唯一鍵，用於去重 / 排序）

  progress      Int     @default(0) // 該週整體進度 0-100
  health        Health  @default(GREEN) // 該週狀態（RAG）
  thisWeekGoals String? @db.Text // 本週目標
  thisWeekDone  String? @db.Text // 本週完成
  nextWeekGoals String? @db.Text // 下週目標
  risks         String? @db.Text // 風險 / 阻礙
  needsDecision String? @db.Text // 需要老闆決策（空＝無）
  note          String? @db.Text // 其他備註

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  tasks WeeklyTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, weekStart])
  @@index([weekStart])
}

/// 每週進度紀錄下的具體任務，可指定負責人。
model WeeklyTask {
  id             String       @id @default(cuid())
  weeklyUpdateId String
  weeklyUpdate   WeeklyUpdate @relation(fields: [weeklyUpdateId], references: [id], onDelete: Cascade)
  title          String
  done           Boolean      @default(false)
  assigneeId     String?
  assignee       User?        @relation(fields: [assigneeId], references: [id])
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([weeklyUpdateId])
}

// 版本發布狀態（changelog）：規劃中 / 已發布。
enum ReleaseStatus {
  PLANNED // 規劃中 / 未發布
  RELEASED // 已發布
}

/**
 * 專案版本發布紀錄（changelog）。依 Keep a Changelog + SemVer 慣例：每筆一個版本號、
 * 發布日期、狀態與變更說明（notes 支援 Markdown）。最新版本顯示在專案摘要 Hero。
 */
model ProjectRelease {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version    String // 版本號，如 v1.2.0
  title      String? // 摘要標題（選填）
  notes      String?       @db.Text // 變更說明（Markdown）
  status     ReleaseStatus @default(RELEASED)
  releasedAt DateTime?     @db.Date // 發布日（規劃中可空）

  sortOrder   Int      @default(0)
  createdById String? // 建立者（顯示用，不設關聯）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model Milestone {
  id        String          @id @default(cuid())
  projectId String
  title     String
  detail    String?         @db.Text
  status    MilestoneStatus @default(PLANNED)

  plannedDate DateTime? @db.Date // 理想時程
  actualDate  DateTime? @db.Date // 實際達成時程

  isGoal    Boolean @default(false) // 設為「目標」（vs 一般里程碑）
  sortOrder Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// 操作紀錄的種類（決定圖示 / 篩選；NOTE＝使用者手動備註）
enum ActivityKind {
  CREATE // 建立專案
  STATUS // 狀態變更
  HEALTH // 健康度變更
  PROGRESS // 進度變更
  FIELD // 一般欄位編輯
  MILESTONE // 里程碑變更
  MEMBER // 成員變更
  WEEKLY // 週報變更
  RELEASE // 版本發布變更
  ARCHIVE // 封存 / 取消封存
  NOTE // 使用者手動備註
}

/**
 * 專案操作紀錄（活動軌跡）。系統在各動作後自動寫入；使用者亦可手動新增備註（kind=NOTE）。
 * 任何一筆都可被刪除（內部團隊工具）。
 */
model Activity {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      ActivityKind @default(NOTE)
  message   String       @db.Text // 顯示文字（如「狀態：進行中 → 已完成」）
  userId    String? // 操作者（手動備註必有；系統動作通常有）
  user      User?        @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([projectId, createdAt])
}

/**
 * 專案清單的「視窗 / 分頁」。「全體」為系統視窗（isSystem，不可刪），其餘可自由新增/刪除。
 * 每個視窗用 status / type 篩選專案（null＝不限）。
 */
model ProjectView {
  id        String          @id @default(cuid())
  name      String
  /**
   * 篩選條件：狀態 / 類型（空陣列＝不限）。
   */
  statuses  ProjectStatus[]
  types     ProjectType[]
  /**
   * true＝反向：顯示「不符合」上述條件的專案（排除某些）。
   */
  exclude   Boolean         @default(false)
  isSystem  Boolean         @default(false) // 「全體」＝true，不可刪除
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// 每週週報的「整體說明」自由文字（每週一筆，依週一日期為唯一鍵）。
model WeeklyReport {
  id          String   @id @default(cuid())
  weekStart   DateTime @db.Date
  summary     String   @db.Text // 純文字鏡像（不含圖片 raw data，給 log / 純文字情境）
  contentHtml String?  @db.Text // 文件內文（像 doc/email，文字與內嵌圖片在一起）
  images      String[] // 舊版圖片欄位（保留相容）
  content     Json? // 舊版區塊（保留相容）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, weekStart])
}

/// 週報內文的圖片（以二進位存，內文只引用短網址，base64 不會流經 action / log）。
model ReportImage {
  id        String   @id @default(cuid())
  data      Bytes
  mime      String   @default("image/jpeg")
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// 會議記錄（全體會議 / 研發部會議 等）。依日期歸入對應週、顯示在該週週報。
model Meeting {
  id           String    @id @default(cuid())
  date         DateTime  @db.Date
  category     String // 例：全體會議 / 研發部會議
  title        String
  attendeeIds  String[] // 與會成員（User id；「全體」＝全部成員）
  attendees    String?   @db.Text // 其他與會者（非系統成員，自由文字）
  link         String?   @db.Text // 會議連結（Google Meet / 會議文件…；可能很長）
  // 會議記錄 / 決議：一段 HTML（圖片以 <img> 內嵌、文字環繞排版，像 Word 插入圖片）。
  // 送出前後端都會用 sanitize-html 過白名單，見 server/actions/meetings.ts。
  notes        String?   @db.Text
  // 舊版「筆記畫布」留下的浮動圖片：[{id,url,xPct,yPct,wPct,hPct}] 或 [{id,url}]（不同代改版）。
  // 新資料一律不寫這欄——圖片已內嵌進 notes 的 HTML 裡；只保留給改版前的舊紀錄顯示 fallback 用。
  noteImages   Json?
  createdById  String?
  recordedById String? // 記錄人；新增時預設帶入建立者，可事後改成別人
  // AI 總結（Markdown）：由組織自備的 Gemini key 依 notes 產生，可重新產生；notes 改了不會自動更新。
  aiSummary    String?   @db.Text
  aiSummaryAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([date])
}

/// AI 呼叫用量紀錄：每次呼叫 Gemini 一筆（含失敗），供組織查看用量。token 數取自 API 回傳的 usageMetadata。
model AiUsage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String? // 觸發的人（被刪除時保留紀錄）
  feature        String // "crm_card" | "foodlabel_ocr" | "meeting_summary"
  model          String
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  totalTokens    Int          @default(0)
  costUsd        Float        @default(0) // 依寫入當下的價目換算（見 src/lib/ai-pricing.ts）
  ok             Boolean      @default(true)
  error          String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/// 組織年度假日清單（「匯入年度假日」對話框記住的內容）。一筆可以是單日或區間（date ~ endDate，含頭尾）。
/// 套用時會展開成每位追蹤成員當天的放假紀錄（AttendanceRecord.holiday）；出席月曆對沒有紀錄的人
/// （新進 / 未追蹤）也會直接顯示成放假。
model OrgHoliday {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date // 起日
  endDate        DateTime     @db.Date // 迄日（單日＝同 date）
  name           String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, date])
}

/// 每日出席紀錄（每人每日最多一筆；present=有出席，false=缺席）。
/// 只追蹤 User.trackAttendance = true 的成員，供出席月曆一眼檢視。
model AttendanceRecord {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  present     Boolean    @default(true) // true=出席 / false=缺席（offsite 時 present 不看，另以圈圈呈現）
  reason      String? // 事由（請假 / 出差 / 在家工作…；選填）
  offsite     Boolean    @default(false) // 出差 / 在家工作（在外工作）：出席月曆顯示為圈圈
  holiday     Boolean    @default(false) // 休假 / 放假：既不算出席也不算缺席（週末預設放假不寫入，這是人工指定的休）
  leave       Boolean    @default(false) // 請假（特休 / 事假 / 病假…）：既不算出席也不算缺席，事由記在 reason
  // 時數請假（同一天內請幾小時）：與 leave 互斥——只是扣薪 / 額度換算會多算
  // leaveHours/該員標準工時 天，leave=true 那天不會同時有值。present 仍照實際打卡
  // 狀態認定，不因為有時數請假就自動視為出席（見 leave-requests.ts materializeApprovedLeave）。
  leaveHours  Float?
  // 請假時對應的假別（決定薪資扣薪比例）。null＝未指定假別的一般請假（薪資視為無薪，可由 HR 補指派）。
  leaveTypeId String?
  leaveType   LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  auto        Boolean    @default(false) // 由成員事件自動產生（vs 人工登記）；人工編輯會清為 false
  /// 人工「清除」的墓碑：明確標記這天「就是未記錄」。
  /// 直接刪除紀錄不夠——沒有紀錄的過去平日會被「未打卡自動缺席」重新標成缺席，
  /// 來自事件的紀錄也會被 recomputeAttendance 重新產生。留一筆 cleared+auto=false 的
  /// 紀錄才壓得住這兩者。顯示為「未記錄」，不列入出席 / 缺席 / 薪資統計。
  cleared     Boolean    @default(false)
  createdById String? // 登記者
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, date])
  @@index([organizationId])
  @@index([date])
  @@index([leaveTypeId])
}

/// 成員事件（請假 / 出差 / 在家工作 等），記在個人 profile。
/// 出差 / 事件登記。送出時把組織的簽核關卡（與請假共用同一組）解析成一串
/// MemberEventApproval，依序簽核；核准後才落地到出席月曆（見 lib/attendance-sync.ts）。
/// 例外：出勤管理權限者代他人登記一律直接 APPROVED，免簽核——見 server/actions/member-events.ts 註解。
model MemberEvent {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // 請假 / 出差 / 在家工作 / 外出 / 其他
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date // 範圍結束（null＝單日）
  note           String?   @db.Text
  attachment     String?   @db.Text // 證明附件（data URL；圖片 / PDF）
  attachmentName String? // 附件原始檔名
  createdById    String?
  createdAt      DateTime  @default(now())

  // PENDING（待簽核）| APPROVED（已核准）| REJECTED（已駁回）——語意與 LeaveRequest.status 相同。
  status      String    @default("PENDING")
  currentStep Int       @default(0) // 目前待簽核的關卡索引（0-based）
  decidedAt   DateTime? // 最終定案（核准 / 駁回）時間；免簽核則等於 createdAt

  approvals MemberEventApproval[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([userId, startDate])
}

/// 單一事件登記的其中一關簽核，結構與 LeaveApproval 相同（沿用同一組「簽核流程」設定）。
model MemberEventApproval {
  id               String             @id @default(cuid())
  eventId          String
  event            MemberEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sortOrder        Int                @default(0) // 這關在本次登記中的順序（0-based）
  approverMemberId String
  approverMember   OrganizationMember @relation("MemberEventApprovalApprover", fields: [approverMemberId], references: [id], onDelete: Cascade)
  // PENDING（待簽）| APPROVED（已核准）| REJECTED（已駁回）
  status           String             @default("PENDING")
  comment          String?            @db.Text
  decidedAt        DateTime?
  createdAt        DateTime           @default(now())

  @@index([eventId, sortOrder])
  @@index([approverMemberId, status])
}

// ─────────────────────────────────────────────
// OKR（目標與關鍵成果）
// OKR 是「即時鏡子」：Objective 依季別分組 KR；KR 可連到一個 Project，
// 連上後其狀態/進度/健康度改讀專案當下值（不落庫），未連的才手動填。
// ─────────────────────────────────────────────

enum KrStatus {
  NOT_STARTED // 未開始
  IN_PROGRESS // 進行中
  DONE // 已完成
  BLOCKED // 延宕 / 卡住
  CANCELLED // 取消
}

// 策略層 OKR 的層級：年度 / 季度（公司營運頁分兩區呈現）。
enum OkrLevel {
  ANNUAL // 年度 OKR（cycle＝年份，如 "2026"）
  QUARTERLY // 季度 OKR（cycle＝季別，如 "2026 Q3"）
}

/// 公司 OKR 的年份 / 季度（使用者自行新增，可以先建空的再加目標）。quarter=0 代表「年份本身」，
/// 1–4 代表該年的 Q1–Q4。Objective 仍以 cycle 字串（"2026" / "2026 Q3"）歸屬，這張表只決定畫面上有哪些年份 / 季度。
model OkrPeriod {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  quarter        Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, year, quarter])
}

/// 目標（Objective）＝公司營運頁的策略層 OKR。依組織 + 層級(level) + 週期(cycle) 分組，底下掛多條 KeyResult。
model Objective {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  level       OkrLevel  @default(QUARTERLY) // 年度 / 季度
  cycle       String // 週期：年度＝年份 "2026"；季度＝"2026 Q3"
  targetDate  DateTime? @db.Date // 目標日期（7/10、8月底…）
  sortOrder   Int       @default(0)
  archived    Boolean   @default(false)

  ownerId String?
  owner   User?   @relation("ObjectiveOwner", fields: [ownerId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  keyResults KeyResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, cycle])
}

/// 關鍵成果（Key Result）。連到 Project 時＝即時鏡子（狀態/進度讀專案）；
/// 未連時用自身 status/progress/health（供非專案的檢查點：律師看過合約、名片…）。
model KeyResult {
  id          String    @id @default(cuid())
  objectiveId String
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  title       String
  kind        String    @default("kr") // "kr" | "todo"

  // 連到專案（可選）＝即時抓專案當下狀態；null＝手動。
  projectId String?
  project   Project? @relation("KrProject", fields: [projectId], references: [id], onDelete: SetNull)

  // 手動 KR 用（連了專案就改讀專案的，這些被忽略）。
  status   KrStatus  @default(NOT_STARTED)
  health   Health    @default(GREEN)
  progress Int       @default(0) // 0-100
  note     String?   @db.Text // 這週目標 / 備註
  dueDate  DateTime? @db.Date

  owners     User[]  @relation("KrOwners") // 多負責人（組織成員）
  ownerLabel String? // 外部非成員自由文字（律師 Also…）

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objectiveId])
  @@index([projectId])
}

/// 任務（Task）＝合併「專案與任務」頁裡，掛在某專案卡片下的一列。
/// 專案卡片的彙總進度/健康度由底下任務即時算出並回寫到 Project（供時程/週報/連動 KR 共用）。
model Task {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation("ProjectTask", fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String? @db.Text // 任務說明（這個任務要做什麼）

  status    KrStatus  @default(NOT_STARTED)
  health    Health    @default(GREEN)
  progress  Int       @default(0) // 0-100
  note      String?   @db.Text // 這週目標 / 備註
  startDate DateTime? @db.Date // 開始日
  dueDate   DateTime? @db.Date // 結束 / 到期日

  // 到期提醒：到期日「前 N 天」提醒（天數自由設定，可多個，如 [7,3,1]）。
  // 每日 cron 依此發站內通知給任務負責人。空＝不提醒。
  reminderDays Int[] @default([])

  owners     User[]  @relation("TaskOwners") // 多負責人（組織成員）
  ownerLabel String? // 外部非成員自由文字

  // 主負責人：owners 之中被指定為「主要負責」的一位（可空）。移除該負責人時一併清除。
  primaryOwnerId String?
  primaryOwner   User?   @relation("TaskPrimaryOwner", fields: [primaryOwnerId], references: [id], onDelete: SetNull)

  todoItems TodoItem[] // 個人待辦可關聯到此任務

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ─────────────────────────────────────────────
// 每日報告（Daily report）— 每人每日一筆，量化自評 + 短備註。
// 只有作者本人與其上級主管（依組織設定決定是否含更上層）看得到。
// ─────────────────────────────────────────────

model DailyReport {
  id    String   @id @default(cuid())
  date  DateTime @db.Date // 報告日（UTC 午夜；每人每日唯一）
  score Int      @default(0) // 自評完成度 0–100（量化）
  note  String? // 今日重點（≤50 字，於 action 驗證）

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  comments  DailyReportComment[]
  items     DailyReportItem[]
  reactions DailyReportReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId, date])
  @@index([organizationId, date])
  @@index([userId, date])
}

/// 每日報告底下的工作項目（陳宗賢式：計畫 vs 實績量化）。
/// 每項有目標數量與實際完成數量，達成率＝實際/目標；日報 score 由各項達成率平均得出。
model DailyReportItem {
  id       String      @id @default(cuid())
  reportId String
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  title  String // 任務 / 工作項目
  unit   String? // 單位（件 / 通 / % …），選填
  target Float   @default(0) // 目標數量（分母）
  actual Float   @default(0) // 實際完成數量（分子）

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reportId])
}

/// 每日報告的留言（主管回饋）。新增後會通知報告作者。
model DailyReportComment {
  id        String      @id @default(cuid())
  reportId  String
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String      @db.Text
  createdAt DateTime    @default(now())

  @@index([reportId])
}

/// 每日報告的表情回應（Slack 式 emoji reaction）。可見該日報的人（本人＋主管）皆可按；
/// 同一人對同一份日報的同一個 emoji 只有一筆（再按即取消＝可切換）。
model DailyReportReaction {
  id        String      @id @default(cuid())
  reportId  String
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String // emoji 字元（如 👍）；允許清單於 lib/daily.ts 定義並於 action 驗證
  createdAt DateTime    @default(now())

  @@unique([reportId, userId, emoji])
  @@index([reportId])
}

/// 站內通知（例：主管回饋你的每日報告）。read=已讀。
model Notification {
  id        String   @id @default(cuid())
  userId    String // 收件者
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 例：daily_comment
  title     String
  body      String?  @db.Text
  link      String? // 點擊前往的頁面
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([organizationId])
}

/// 打卡紀錄（上班 / 下班）。valid=通過 IP / 地理圍欄驗證。有效上班打卡會標記當日出席。
model CheckIn {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date // 打卡日（供每日聚合）
  at     DateTime @default(now()) // 實際打卡時間
  kind   String // "in"（上班）/ "out"（下班）
  method String? // 通過方式："ip" / "gps"（valid=false 時為 null）
  valid  Boolean  @default(false)
  ip     String?
  lat    Float?
  lng    Float?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@index([userId, date])
}

/// 補打卡申請：成員忘記上/下班打卡時提出，經具 attendance.manage 者核准後補一筆有效打卡（計入工時）。
model CheckInCorrection {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date // 要補的打卡日
  kind   String // "in"（上班）/ "out"（下班）
  at     DateTime // 申請補登的實際打卡時間
  reason String?  @db.Text // 事由（忘記打卡原因）

  status          String    @default("pending") // pending | approved | rejected
  reviewedById    String? // 審核者 userId
  reviewedAt      DateTime?
  reviewNote      String? // 審核備註（駁回原因等）
  resultCheckInId String? // 核准時補建立的 CheckIn.id；本人事後刪除此申請時一併移除該筆打卡紀錄

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, status])
  @@index([userId, date])
}

// ─────────────────────────────────────────────
// 員工教育訓練（Training）— 課程目錄 + 指派給成員 + 完成追蹤。
// 必修（法遵）可設有效月數，完成後到期需重訓；支援分類、教材連結、預估時數。
// ─────────────────────────────────────────────

enum TrainingFormat {
  ONLINE // 線上課程
  VIDEO // 影片
  DOCUMENT // 文件 / 閱讀
  IN_PERSON // 實體 / 講座
  EXTERNAL // 外部課程 / 認證
}

enum TrainingStatus {
  NOT_STARTED // 未開始
  IN_PROGRESS // 進行中
  COMPLETED // 已完成
}

/// 訓練課程（課程目錄；由管理者建立、指派給成員）。
model TrainingCourse {
  id           String         @id @default(cuid())
  title        String
  description  String?        @db.Text
  category     String         @default("一般") // 新人訓練 / 法遵 / 專業技能 / 職場安全 / 一般
  format       TrainingFormat @default(ONLINE)
  resourceUrl  String? // 教材 / 課程連結
  estimatedMin Int? // 預估時數（分鐘）
  required     Boolean        @default(false) // 必修（法遵 / 強制）
  renewMonths  Int? // 有效月數（完成後幾個月需重訓；null＝永久）
  active       Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignments TrainingAssignment[]

  @@index([organizationId])
}

/// 課程指派（每位成員每門課一筆）＝該員的訓練紀錄（狀態 / 到期日 / 完成日 / 分數）。
model TrainingAssignment {
  id           String         @id @default(cuid())
  courseId     String
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       TrainingStatus @default(NOT_STARTED)
  dueDate      DateTime?      @db.Date // 應完成日
  startedAt    DateTime?
  completedAt  DateTime?
  score        Int? // 測驗分數（選填 0–100）
  note         String?        @db.Text
  assignedById String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([organizationId])
  @@index([userId, status])
  @@index([courseId])
}

// ─────────────────────────────────────────────
// 員工教育訓練文件庫（Training Docs）— 巢狀資料夾 + markdown 文件。
// 取代原本的「課程指派 / 完成追蹤」，改成內部知識庫 / wiki 形式：
// 資料夾可多層巢狀（parentId 自參照），最底層是可用 markdown 編輯的文件（TrainingDocPage）。
// 資料夾 / 文件皆可自由新增命名。管理者(OWNER/ADMIN)編輯，組織成員皆可讀 + 搜尋。
// ─────────────────────────────────────────────

/// 文件資料夾（可多層巢狀）。刪除資料夾會連同子資料夾與其中文件一併移除（DB 層級聯串）。
model TrainingDocFolder {
  id             String       @id @default(cuid())
  name           String
  sortOrder      Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // 自參照樹狀結構：parentId 為 null＝根層資料夾。
  parentId String?
  parent   TrainingDocFolder?  @relation("DocFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TrainingDocFolder[] @relation("DocFolderTree")

  pages TrainingDocPage[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([parentId])
}

/// 文件（樹葉節點）：內容以 markdown 純文字儲存。folderId 為 null＝放在根層。
model TrainingDocPage {
  id        String @id @default(cuid())
  title     String
  content   String @default("") @db.Text // markdown 原文
  sortOrder Int    @default(0)

  // 可見性：ALL＝所有人可見（預設）；RESTRICTED＝僅 allowedUserIds 內的人可見。
  // 管理者(OWNER/ADMIN/老闆)一律可見，不受此限制。
  visibility     String   @default("ALL")
  allowedUserIds String[] @default([]) // RESTRICTED 時的白名單（user id）
  // 編輯白名單：除了管理者(OWNER/ADMIN)一律可編輯外，額外可編輯這份文件的成員 user id。
  editorUserIds  String[] @default([])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  folderId String?
  folder   TrainingDocFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([folderId])
}

// ─────────────────────────────────────────────
// CRM（客戶關係管理）：聯絡人 + 商機銷售管線 + 活動時間軸
// 業界慣例：以「管線階段(stage)」推進商機；成交/流失後離開管線。org-scoped。
// ─────────────────────────────────────────────

enum CrmDealStatus {
  OPEN // 進行中（在管線上）
  WON // 成交
  LOST // 流失
}

/// 聯絡人 / 客戶（公司或個人）。
model CrmContact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String // 主要聯絡人姓名
  company String? // 公司名稱
  title   String? // 職稱
  email   String?
  phone   String?
  note    String? @db.Text

  decisionRole String? // 決策者 / 影響者 / 窗口 / 使用者（自由文字，UI 給預設選項）

  // 名片照片（前端壓縮後的 data URL）。刻意不放進 getCrmContacts 的列表查詢
  // （只在編輯單一聯絡人時才查），避免像頭貼那次一樣把大 blob 拖進不需要它的查詢。
  businessCardImage String? @db.Text

  // 同一企業內的匯報 / 關係對象（只在同公司內有意義，UI 端限制選項）。
  reportsToId String?
  reportsTo   CrmContact?  @relation("CrmContactReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     CrmContact[] @relation("CrmContactReportsTo")

  ownerId     String?
  owner       User?   @relation("CrmContactOwner", fields: [ownerId], references: [id])
  createdById String?

  deals     CrmDeal[]
  dealLinks CrmDealContact[]
  events    CrmEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([reportsToId])
}

/// 商機 / 交易（銷售管線的一張卡）。
model CrmDeal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title  String
  value  Int           @default(0) // 金額（日圓，整數）
  stage  String        @default("LEAD") // DealStage.key（每組織可自訂階段）
  status CrmDealStatus @default(OPEN)

  // 主要聯絡人 / 主要負責人——鏡射自下方 CrmDealContact / CrmDealOwner 裡 isPrimary=true
  // 的那筆。看板卡片、跟進清單、儀表板統計、通知這些「只在乎一個人」的地方繼續讀這兩欄，
  // 不用全部改成陣列；完整名單（含協同負責人 / 其他關聯聯絡人）才去查 contactLinks / ownerLinks。
  // 由 syncDealTeam()（server/actions/crm.ts）在建立 / 編輯商機時一併寫入，維持兩邊同步。
  contactId String?
  contact   CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("CrmDealOwner", fields: [ownerId], references: [id])

  expectedCloseDate DateTime? @db.Date // 預計成交日
  closedAt          DateTime? // 成交 / 流失時間
  closedReason      String?   @db.Text // 成交 / 流失原因（設狀態時選填）
  probability       Int? // 成交機率 0-100；未填則沿用 DealStage.defaultProbability
  note              String?   @db.Text
  sortOrder         Int       @default(0) // 同一階段內排序
  createdById       String?

  activities        CrmActivity[]
  stageChanges      DealStageChange[]
  contactLinks      CrmDealContact[]
  ownerLinks        CrmDealOwner[]
  viewCells         CrmViewCellValue[]
  // 食品標示模組：掛在這個商機底下的輸台商品（未安裝該模組時恆為空）。
  foodLabelProducts FoodLabelProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([contactId])
  @@index([organizationId, stage])
}

/// 商機關聯的聯絡人（多對多）；恰好一筆 isPrimary=true 為主要窗口，鏡射到 CrmDeal.contactId。
model CrmDealContact {
  id        String     @id @default(cuid())
  dealId    String
  deal      CrmDeal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String
  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  isPrimary Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@unique([dealId, contactId])
  @@index([dealId])
  @@index([contactId])
}

/// 商機的負責人（多對多）；恰好一筆 isPrimary=true 為主要負責人，其餘為協同負責人，
/// 主要負責人鏡射到 CrmDeal.ownerId。
model CrmDealOwner {
  id        String   @id @default(cuid())
  dealId    String
  deal      CrmDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("CrmDealOwnerMember", fields: [userId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([dealId, userId])
  @@index([dealId])
  @@index([userId])
}

/// 每組織可自訂的銷售管線階段（看板欄位）。key 為穩定鍵，CrmDeal.stage 存 key。
model DealStage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key                String // 穩定鍵：預設階段用語意鍵（LEAD…），自訂為 cuid
  label              String // 顯示名稱（可編輯）
  note               String? @db.Text // 小備註（顯示於欄位上方）
  color              String  @default("slate") // 色名（slate/sky/cyan/violet/amber/emerald/rose/zinc…）
  defaultProbability Int? // 此階段預設成交機率 0-100（供加權管線金額；商機可個別覆寫）
  sortOrder          Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

/// 商機的階段異動時間線（每次換階段記一筆，含原因），供視覺化客戶狀態歷程。
model DealStageChange {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dealId String
  deal   CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  fromStage String? // 前一階段 key（建立商機時為 null）
  toStage   String // 新階段 key
  reason    String? @db.Text // 這次調整的原因

  changedById String?
  changedAt   DateTime @default(now())

  @@index([dealId, changedAt])
  @@index([organizationId])
}

/// 自訂欄位的型別。STAGE 是「綁定既有資料」的特例：它不自己存值，讀寫的就是
/// CrmDeal.stage／DealStage（跟銷售看板共用同一份資料）——這樣試算表分頁跟看板分頁
/// 永遠是同一份現況的兩種呈現，而不是兩份會兜不起來的平行資料。MAIL 是「一欄＝一輪
/// 寄信」的複合欄位：寄送／已讀兩個時間戳存在 CrmViewCellValue 的 JSON 裡（見該
/// model 註解），頭／中／尾三段信件內容則掛在欄位本身（header／template／footer）
/// ——每一輪的頭尾可能不一樣（例如首次接觸信跟追加信的開場白就不同），所以不是全
/// View 共用一套，是每個 MAIL 欄位各自一套。其餘型別都是這個 View 自己的、跟
/// CrmDeal 一對一存值的自由欄位。
enum CrmViewColumnType {
  STAGE
  CHECKBOX
  DATE
  TEXT
  SELECT
  MAIL
}

/// 使用者可自訂的 CRM 分頁（試算表清單，如業務開發追蹤表）：一列＝一個商機
/// （CrmDeal），欄位完全自訂（見 CrmViewColumn）。刻意不建立「這個 View 底下有哪些
/// 商機」的關聯——所有自訂分頁都讀同一份組織商機清單（跟 Pipeline／漏斗現有做法一致），
/// 只是換一種欄位配置去看，不是另外開一份平行名單。
model CrmView {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int    @default(0)

  columns CrmViewColumn[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
}

/// CrmView 底下一欄的定義。key 為穩定鍵（新增時給 cuid），CrmViewCellValue.columnId
/// 對應到這裡；label／type／selectOptions／順序都可事後編輯，跟 DealStage 的
/// 「每組織可自訂」是同一套精神。
model CrmViewColumn {
  id     String  @id @default(cuid())
  viewId String
  view   CrmView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  label         String
  type          CrmViewColumnType
  selectOptions String[]          @default([]) // 僅 type=SELECT 使用；可自訂增刪選項
  // 以下三個都僅 type=MAIL 使用，可含 {{企業名}} 插入公司名稱：
  header        String?           @db.Text // 這一輪信件的開頭（每輪各自，跟其他輪不共用）
  template      String?           @db.Text // 這一輪信件「中間」的預設範本——新格子第一次編輯時的起始內容，
  // 之後每家企業各自修改，改完就存在該格子自己的值裡，不會再跟著範本變動（見 CrmViewCellValue）
  footer        String?           @db.Text // 這一輪信件的結尾（每輪各自，跟其他輪不共用）
  sortOrder     Int               @default(0)

  values CrmViewCellValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([viewId])
}

/// 某商機在某自訂欄位上的值（type=STAGE 的欄位不會有對應資料，直接讀 CrmDeal.stage）。
/// CHECKBOX 存 "true"/"false"、DATE 存 yyyy-mm-dd、TEXT/SELECT 存原文、MAIL 存 JSON
/// 字串 {"sent":boolean,"sentDate":string|null,"read":boolean,"readDate":string|null,
/// "body":string}——寄送／已讀各自的狀態與日期，加上這家企業「這一輪」信件中間內容
/// 的個人化版本（body，每家企業各自獨立，第一次編輯前顯示欄位的 template 當預設稿）。
model CrmViewCellValue {
  id       String        @id @default(cuid())
  columnId String
  column   CrmViewColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  dealId   String
  deal     CrmDeal       @relation(fields: [dealId], references: [id], onDelete: Cascade)

  value String? @db.Text

  updatedAt DateTime @updatedAt

  @@unique([columnId, dealId])
  @@index([dealId])
}

/// 商機的活動 / 備註時間軸（電話 / 會議 / Email / 備註 / 待辦）。
model CrmActivity {
  id     String  @id @default(cuid())
  dealId String
  deal   CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  type    String    @default("note") // note | call | email | meeting | task
  body    String    @db.Text
  dueDate DateTime? @db.Date // task 用（跟進提醒）
  done    Boolean   @default(false)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dealId])
}

/// CRM 活動紀錄（org-scoped，獨立於商機）：以類似會議記錄的方式記錄拜訪 / 電話 /
/// 活動 / Email 等，含日期、類型、主題、內容與可選連結。
model CrmEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  date  DateTime @db.Date
  type  String   @default("活動") // 拜訪 / 電話 / 活動 / Email / 會議 / 其他
  title String
  notes String?  @db.Text
  link  String?  @db.Text // 可選連結（可能很長）

  // 可選：關聯到某個客戶（聯絡人）。
  contactId String?
  contact   CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([date])
  @@index([contactId])
}

/// 企業層級的狀態備註（依 CrmContact.company 字串分組，同名視為同一企業）。
/// 跟聯絡人 / 商機各自的備註是分開的：這裡記的是「這家公司整體目前是什麼狀態」
/// （例如關係階段、偏好、注意事項），不綁在單一聯絡人或單一商機底下。
/// 同一企業一筆（用 company 字串當 key，跟企業時間軸的分組邏輯一致）。
model CrmCompanyNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  company String
  body    String @db.Text

  // parentId 為 null＝主動態；有值＝某則底下的留言（只做一層，不支援留言的留言）。
  parentId String?
  parent   CrmCompanyNote?  @relation("CrmCompanyNoteReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  CrmCompanyNote[] @relation("CrmCompanyNoteReplies")

  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, company])
  @@index([parentId])
}

/// 企業（廠商／潛在客戶）基本檔案（2026-08 新增；依 CrmContact.company 字串分組，
/// 同名視為同一企業，跟 CrmCompanyNote／企業時間軸同一套分組邏輯——目前「企業」沒有
/// 獨立主表，這張表補的是「這家公司本身是誰」，不是互動紀錄）。同一企業一筆。
/// 常見來源：業務開發名單匯入（廠商查證資料）、後續手動補充/編輯。
model CrmCompanyProfile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  company String

  /// 產業類別（自由文字，例如「食品・銘菓」「陶磁器・工芸」「調味料・発酵」）。
  industry           String?
  /// 地點（自由文字，可比單純縣市更細，例如「福岡・新宮町」）。
  location           String?
  /// 公司人數／員工數（自由文字——來源口徑常不一致，如「役員3・正社員13・従業員50、計66名」，
  /// 保留原始描述比硬塞成單一數字更不失真）。
  headcount          String?
  /// 資本額（自由文字，例如「資本金1000万円」——原始揭露格式不一定是乾淨數字，比照 headcount）。
  capital            String?
  /// 創業／設立年份或沿革（自由文字，例如「1976年創業」「2000年創業、2008年11月法人化」）。
  founded            String?
  website            String?
  /// 代表人／負責人姓名。
  representativeName String?
  /// 販賣的產品／主要業務內容（自由文字敘述，代表性列幾種即可）。
  products           String?  @db.Text
  /// 產品類型（封閉選項，供統計分頁分組用；見 src/lib/crm-company-stats.ts 的
  /// PRODUCT_CATEGORY_OPTIONS——跟 industry 的差異是這個是給機器分組用的粗分類，
  /// industry 是給人看的自由描述）。
  productCategory    String?
  /// 公司介紹（背景、特色、沿革等敘述）。
  companyIntro       String?  @db.Text
  /// 切入點（業務開發用：這家公司值得從哪個角度接觸、鉤子是什麼）。
  entryHook          String?  @db.Text
  /// 是否有直營店面；null＝未查證/不確定。
  hasPhysicalStore   Boolean?
  /// 是否有電商；null＝未查證/不確定。跟 ecommercePlatform 分開存——「有沒有」跟「用哪個平台」
  /// 是兩個問題，先確定有沒有電商，平台是進一步的細節（可能查得到有電商但查不到用哪個平台）。
  hasEcommerce       Boolean?
  /// 電商平台（自由文字，如 Shopify／カラーミーショップ／MakeShop／futureshop／楽天／自社サイト）。
  ecommercePlatform  String?
  /// 優先級（自由文字，如業務開發名單常見的 A/B/C 分級）；不是系統定義的 enum，供各組織自訂用法。
  grade              String?
  /// 備註（其他不適合放進上面欄位的補充資訊）。
  note               String?  @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, company])
}

// ─────────────────────────────────────────────
// 個人待辦（Todo）+ 番茄鐘（Pomodoro）——每個人自己管理，不與他人共享。
// ─────────────────────────────────────────────

/// 個人待辦事項。可選擇性關聯到某個專案任務(Task)；有開始 / 結束日。
model TodoItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title String
  note  String? @db.Text // 備註（選填，自由文字）
  done  Boolean @default(false)

  startDate DateTime? @db.Date // 開始日
  dueDate   DateTime? @db.Date // 結束 / 到期日

  // 關聯到的專案任務（可選；任務被刪則設為 null 不連帶刪待辦）。
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pomodoros PomodoroSession[]

  @@index([userId])
  @@index([organizationId])
  @@index([taskId])
}

/// 番茄鐘專注紀錄。durationSec＝該次專注秒數；可選擇性關聯到某個待辦。
model PomodoroSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  todoId String?
  todo   TodoItem? @relation(fields: [todoId], references: [id], onDelete: SetNull)

  startedAt   DateTime @default(now()) // 開始專注的時間
  durationSec Int // 專注時長（秒）
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([todoId])
}

// ─────────────────────────────────────────────
// 人資（HR）：自訂角色 / 權限、假別、薪資設定、薪資單
// 角色是「職能角色」（人資 / 會計…），與 OrgRole（OWNER/ADMIN/MEMBER，決定誰是管理者）
// 正交：管理者(OWNER/ADMIN)天生擁有全部權限；一般成員的權限＝其被指派角色權限的聯集。
// permissions 存權限 key（見 src/lib/permissions.ts），非硬編碼列舉，方便日後擴充。
// ─────────────────────────────────────────────

/// 自訂角色（每組織）。只有管理者可建立 / 編輯 / 指派。permissions＝該角色授予的權限 key 清單。
model OrgRoleDef {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String // 角色名稱（人資 / 會計…）
  description    String? // 說明
  color          String? // 標籤顏色（hex）
  permissions    String[]     @default([]) // 權限 key 清單
  // 此角色可見的頁面（module key 清單）。空＝可見全部頁面（不限制）；非空＝只可見列出的頁面（+ 一律可見頁）。
  visibleModules String[]     @default([])
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members OrganizationMember[] @relation("MemberRoles")

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// 假別（每組織）。paidPercent 決定該假別的薪資給付比例（100＝全薪、0＝無薪、50＝半薪）。
model LeaveType {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String // 特休 / 事假 / 病假 / 公假…
  paidPercent     Int          @default(100) // 薪資給付比例 0–100
  annualQuotaDays Float? // 年度可用天數（額度；選填，供顯示 / 未來扣抵）
  color           String?
  sortOrder       Int          @default(0)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ─────────────────────────────────────────────
// 請假簽核（Leave approval）
// 員工送出請假申請 → 依「組織設定的簽核關卡」逐關簽核 → 全部核准才寫入出席月曆。
// 每關的簽核人可以是「申請人的直屬主管」(動態、送出時解析) 或「指定成員」。
// 輪到哪一關，該關的簽核人就會收到站內通知；申請人也會在每次進度 / 定案時收到通知。
// ─────────────────────────────────────────────

/// 請假簽核關卡（每組織一組有序關卡）。approverType 決定該關簽核人如何解析。
model LeaveApprovalStep {
  id               String              @id @default(cuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sortOrder        Int                 @default(0) // 關卡順序（越小越先簽）
  // 簽核人解析方式："MANAGER"＝申請人的直屬主管（送出時動態解析）；"MEMBER"＝下方指定成員。
  approverType     String              @default("MANAGER")
  // approverType="MEMBER" 時指定的簽核成員（OrganizationMember.id）。
  approverMemberId String?
  approverMember   OrganizationMember? @relation("LeaveStepApprover", fields: [approverMemberId], references: [id], onDelete: Cascade)
  createdAt        DateTime            @default(now())

  @@index([organizationId, sortOrder])
  @@index([approverMemberId])
}

/// 請假申請。送出時把組織的簽核關卡解析成一串 LeaveApproval，依序簽核。
model LeaveRequest {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 申請人：membership（供組織內解析主管鏈）＋ userId（供通知 / 出席寫入）雙記。
  memberId       String
  member         OrganizationMember @relation("LeaveRequestMember", fields: [memberId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  leaveTypeId    String?
  leaveType      LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  startDate      DateTime   @db.Date
  endDate        DateTime   @db.Date
  days           Float      @default(0) // 換算工作天（週末不計；顯示 / 統計用）。時數請假＝ hours / 該成員 standardHoursPerDay
  // 時數請假（同一天內請幾小時）。三者要嘛全空（整天請假），要嘛全有值；startDate 須等於 endDate。
  startTime      String? // "HH:mm"
  endTime        String? // "HH:mm"
  hours          Float? // = endTime - startTime（小時，可含分鐘小數）
  reason         String?    @db.Text
  attachment     String?    @db.Text // 證明附件（data URL；圖片 / PDF）
  attachmentName String? // 附件原始檔名

  // 申請人自己選的：核准後要不要同步進組織設定的 Google 日曆（有些假別事由較私密，
  // 不想出現在共用日曆上）。預設 true（維持原本一律同步的行為）；組織根本沒設定
  // 日曆同步時這個欄位不影響任何事。
  syncToCalendar Boolean @default(true)

  // PENDING（待簽核）| APPROVED（已核准）| REJECTED（已駁回）| CANCELLED（已取消）
  status      String    @default("PENDING")
  currentStep Int       @default(0) // 目前待簽核的關卡索引（0-based）
  decidedAt   DateTime? // 最終定案（核准 / 駁回 / 取消）時間

  approvals LeaveApproval[]

  // 軟刪除：HR 在「全體請假」刪除誤送 / 測試 / 重複的申請時，不做實體刪除——
  // 直接刪除會讓這筆請假連同簽核紀錄完全無跡可查（尤其已核准、已影響出勤 / 薪資的申請）。
  // 非空＝已刪除，預設查詢一律排除；HR 可在「已刪除」清單復原（清空這兩欄）。
  deletedAt   DateTime?
  deletedById String? // 刪除者（membership 所屬 userId；供稽核回溯，無 FK）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([memberId])
  @@index([userId])
  @@index([organizationId, deletedAt])
}

/// 單一請假申請的其中一關簽核（送出時由組織關卡解析而來，記錄實際簽核人與其決定）。
model LeaveApproval {
  id               String             @id @default(cuid())
  requestId        String
  request          LeaveRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sortOrder        Int                @default(0) // 這關在本申請中的順序（0-based）
  approverMemberId String
  approverMember   OrganizationMember @relation("LeaveApprovalApprover", fields: [approverMemberId], references: [id], onDelete: Cascade)
  // PENDING（待簽）| APPROVED（已核准）| REJECTED（已駁回）
  status           String             @default("PENDING")
  comment          String?            @db.Text
  decidedAt        DateTime?
  createdAt        DateTime           @default(now())

  @@index([requestId, sortOrder])
  @@index([approverMemberId, status])
}

/// 薪資設定（每位成員一份）。月薪制（MONTHLY）依出勤 / 請假比例計薪；時薪制（HOURLY）依打卡工時計薪。
model SalaryProfile {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String             @unique // OrganizationMember.id
  member         OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  payType             String  @default("MONTHLY") // MONTHLY（月薪）| HOURLY（時薪）
  baseAmount          Decimal @default(0) @db.Decimal(12, 2) // 月薪金額 或 時薪金額
  currency            String  @default("TWD")
  standardWorkDays    Int     @default(22) // 月薪制：每月標準工作天（換算日薪 / 扣薪用）
  standardHoursPerDay Float   @default(8) // 每日標準工時（加班判定 / 時薪換算）
  overtimeMultiplier  Float   @default(1.34) // 加班費倍率（勞基法平日前 2 小時 1.34）
  allowances          Json? // 固定加給 [{ name, amount }]（交通 / 伙食…）
  deductions          Json? // 固定扣除 [{ name, amount }]（勞保 / 健保自付 / 勞退…）
  note                String?

  // ── 勞健保 / 勞退（Phase 1）──
  // 投保薪資：null＝依「本薪＋固定加給」自動對應級距；填值＝手動指定投保金額（如高薪低報 / 特殊申報）。
  insuredSalary   Int?
  dependents      Int     @default(0) // 健保眷口數（0–3，計入員工健保自付）
  laborInsured    Boolean @default(true) // 是否加勞保（普通事故＋就業保險）
  healthInsured   Boolean @default(true) // 是否加健保
  pensionEnrolled Boolean @default(true) // 是否提繳勞退（雇主 6%）
  pensionSelfRate Float   @default(0) // 勞退自願提繳率（0–6%，自薪資扣、可抵稅）

  // 薪資科目金額（Phase 2）：[{ defId, amount }] 對應 SalaryItemDef 目錄，帶入應稅 / 計入投保 / 經常性旗標。
  items           Json?
  // 薪資所得就源扣繳率（Phase 3）：0–1，員工薪資所得稅代扣（0＝不代扣）。
  taxWithholdRate Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// 薪資科目目錄（每組織）。定義薪資項目的旗標：加項 / 減項、應稅 / 免稅、是否計入投保薪資、經常性 / 非經常性。
/// 「本薪」為 SalaryProfile.baseAmount，不在此目錄；此目錄放各式加給 / 獎金 / 扣款。
model SalaryItemDef {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String // 伙食津貼 / 全勤獎金 / 職務加給 / 年終獎金 / 職工福利金…
  kind              String       @default("EARNING") // EARNING（加項）| DEDUCTION（減項）
  taxable           Boolean      @default(true) // 應稅（false＝免稅，如伙食費限額內）
  countsToInsurance Boolean      @default(true) // 是否屬工資、計入投保薪資（差旅 / 非經常獎金 false）
  recurring         Boolean      @default(true) // 經常性（false＝非經常性，如年終 / 績效獎金；二代健保高額獎金判定用）
  taxFreeLimit      Int? // 免稅上限（如伙食 3000/月）；超過部分計為應稅
  active            Boolean      @default(true)
  sortOrder         Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// 薪資 / 勞健保設定（每組織一份）。費率與投保級距是「資料」不是「程式碼」——可一鍵帶當年法定預設、之後自行維護。
model PayrollSetting {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // 費率（小數，如 0.125＝12.5%）
  laborRate           Float @default(0.125) // 勞保費率（普通事故 11.5% ＋ 就業保險 1%）
  laborEmployeeShare  Float @default(0.2) // 勞保勞工自付比例
  laborEmployerShare  Float @default(0.7) // 勞保雇主負擔比例
  healthRate          Float @default(0.0517) // 健保費率
  healthEmployeeShare Float @default(0.3) // 健保勞工自付比例
  healthEmployerShare Float @default(0.6) // 健保雇主負擔比例
  healthAvgDependents Float @default(0.57) // 健保平均眷口（雇主負擔用）
  pensionEmployerRate Float @default(0.06) // 勞退雇主提繳率
  occupationalRate    Float @default(0.002) // 職災保險費率（雇主全負擔，依行業別）
  supplementaryRate   Float @default(0.0211) // 二代健保補充保費費率

  // 投保金額上限（各保險各自的天花板；45,800 以下級距三者共用同一 grid）
  laborCeiling   Int @default(45800) // 勞保最高投保薪資
  healthCeiling  Int @default(313000) // 健保最高投保金額
  pensionCeiling Int @default(150000) // 勞退最高月提繳工資

  minWageMonthly Int @default(29500) // 基本工資（月）
  minWageHourly  Int @default(196) // 基本工資（時）

  // 加班費（勞基法§24，Phase 2）：平日時薪基數＝月薪 ÷ overtimeDivisor（勞基法慣例 240＝30天×8時）
  overtimeDivisor Int   @default(240)
  otWeekday1      Float @default(1.34) // 平日前 2 小時
  otWeekday2      Float @default(1.67) // 平日第 3 小時起
  otRestday1      Float @default(1.34) // 休息日前 2 小時
  otRestday2      Float @default(1.67) // 休息日第 3–8 小時
  otRestday3      Float @default(2.67) // 休息日第 9 小時起

  // 二代健保補充保費門檻（Phase 3）
  supplementaryBonusMultiple Int @default(4) // 高額獎金門檻＝投保金額 × N（累計超過才扣）
  supplementarySingleMin     Int @default(20000) // 單筆計費下限（其他所得類別）

  seededYear Int? // 最後一次帶入法定預設的年度（提示 HR 是否為當年值）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 投保金額分級表（每組織一份清單）。給「工資 → 投保金額」對應：取 ≥ 工資的最小級距，再各自套上限。
/// 45,800 以下勞保 / 健保 / 勞退共用同一組級距，故只存單一 grid。可一鍵帶當年預設、之後自行增修。
model InsuranceBracket {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amount         Int // 投保金額（月）
  sortOrder      Int          @default(0)

  @@unique([organizationId, amount])
  @@index([organizationId, sortOrder])
}

/// 薪資單（每位成員每月一張）。由 HR 產生時依當月出勤 + 薪資設定即時計算並落庫，明細存 breakdown。
model Payslip {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  periodYear  Int
  periodMonth Int // 1–12

  payType         String
  baseAmount      Decimal @default(0) @db.Decimal(12, 2)
  currency        String  @default("TWD")
  // 出勤彙總（供顯示 / 稽核）
  workedDays      Float   @default(0) // 出勤天（含出差 / 在家工作）
  leaveDays       Float   @default(0) // 請假天（各假別合計）
  absentDays      Float   @default(0) // 缺席天
  overtimeHours   Float   @default(0) // 加班時數
  // 金額（TWD，二位小數）
  grossPay        Decimal @default(0) @db.Decimal(12, 2) // 應發（本薪＋加給＋加班 − 請假/缺席扣薪）
  overtimePay     Decimal @default(0) @db.Decimal(12, 2)
  allowanceTotal  Decimal @default(0) @db.Decimal(12, 2)
  leaveDeduction  Decimal @default(0) @db.Decimal(12, 2) // 請假扣薪合計
  absentDeduction Decimal @default(0) @db.Decimal(12, 2) // 缺席扣薪合計
  deductionTotal  Decimal @default(0) @db.Decimal(12, 2) // 應扣合計（勞健保自付＋勞退自提＋固定扣除…）
  netPay          Decimal @default(0) @db.Decimal(12, 2) // 實發

  // ── 勞健保 / 勞退（員工自付；已含入 deductionTotal / netPay）──
  insuredSalary         Int     @default(0) // 投保薪資（快照，供稽核）
  laborInsEmployee      Decimal @default(0) @db.Decimal(12, 2) // 勞保自付
  healthInsEmployee     Decimal @default(0) @db.Decimal(12, 2) // 健保自付（含眷口）
  pensionSelfEmployee   Decimal @default(0) @db.Decimal(12, 2) // 勞退自提
  supplementaryEmployee Decimal @default(0) @db.Decimal(12, 2) // 二代健保員工自付（高額獎金；Phase 3）
  incomeTaxWithheld     Decimal @default(0) @db.Decimal(12, 2) // 薪資所得就源扣繳稅額（Phase 3）
  // 稅務 / 二代健保計算快照（Phase 2/3）
  taxableIncome         Decimal @default(0) @db.Decimal(12, 2) // 當月應稅所得（供扣繳）
  bonusAmount           Decimal @default(0) @db.Decimal(12, 2) // 當月非經常性給與（獎金；二代健保累計用）

  // ── 公司負擔（雇主成本，不影響員工實發；供當月總表 / 帳務）──
  laborInsEmployer      Decimal @default(0) @db.Decimal(12, 2) // 勞保雇主負擔
  healthInsEmployer     Decimal @default(0) @db.Decimal(12, 2) // 健保雇主負擔
  pensionEmployer       Decimal @default(0) @db.Decimal(12, 2) // 勞退雇主提繳（6%）
  occupationalEmployer  Decimal @default(0) @db.Decimal(12, 2) // 職災保險（雇主全負擔）
  supplementaryEmployer Decimal @default(0) @db.Decimal(12, 2) // 二代健保雇主補充保費
  employerCostTotal     Decimal @default(0) @db.Decimal(12, 2) // 公司負擔合計（薪資雇主成本，不含應發）

  breakdown   Json? // 逐項明細（給薪資單呈現）
  status      String   @default("draft") // draft（草稿）| finalized（已核定）
  note        String?
  computedAt  DateTime @default(now())
  createdById String?
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, memberId, periodYear, periodMonth])
  @@index([organizationId, periodYear, periodMonth])
  @@index([memberId])
}

/// 當月一次性獎金 / 調整（三節 / 臨時 / 年終獎金、臨時扣款…）。
/// 只影響「某成員某年某月」，不寫進常駐薪資設定；重算薪資單時會被折算進去，發完該月即結束。
/// 旗標（應稅 / 計入投保 / 非經常性 / 免稅上限）在建立當下由科目快照下來，之後改科目不影響歷史。
model PayslipAdjustment {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  periodYear  Int
  periodMonth Int // 1–12

  label  String // 顯示名稱（如「三節獎金（端午）」；選科目時預帶科目名，可自訂）
  kind   String  @default("EARNING") // EARNING（加項，如獎金）| DEDUCTION（減項，如臨時扣款）
  amount Decimal @db.Decimal(12, 2)

  // 旗標快照（自由填或選科目時一併存；計算時只看這裡，不再回查科目）
  taxable           Boolean @default(true) // 應稅（false＝免稅）
  countsToInsurance Boolean @default(false) // 是否計入投保薪資（一次性獎金通常 false）
  recurring         Boolean @default(false) // 經常性（一次性一律 false＝獎金，供二代健保累計）
  taxFreeLimit      Int? // 免稅上限（免稅科目用）

  sourceDefId String? // 來源薪資科目 id（僅記錄，計算不依賴；科目刪除也不影響）
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([organizationId, memberId, periodYear, periodMonth])
}

// ─────────────────────────────────────────────
// 應用程式（模組）安裝
// ─────────────────────────────────────────────

/// 組織已安裝的應用程式（模組）。
///
/// 三層模組模型的中間層：
///  1. 平台層：`src/lib/modules.ts` 的 MODULES 決定「這個版本有哪些模組」（程式碼決定）。
///  2. 組織層：**這張表**決定「本組織啟用了哪些」——等同 Odoo 的 app install，只有
///     OWNER / ADMIN 能動。
///  3. 成員層：OrganizationMember.allowedModules / OrgRoleDef.visibleModules / 權限
///     決定「誰看得到、能做什麼」。
///
/// 語意：沒有資料列＝未安裝；有列且 enabled=true＝已啟用；enabled=false＝已安裝但停用
/// （資料保留，只是進不去）。核心模組（AppModule.core）不吃這張表，永遠可用。
/// 移除安裝只刪這一列，**不會**刪掉模組自己的資料表內容——重新安裝即回復。
model OrganizationModule {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 對應 src/lib/modules.ts 的 ModuleKey。刻意存字串而非 enum：新增模組不必動 migration。
  moduleKey      String
  enabled        Boolean      @default(true)
  /// 模組自己的組織級設定（各模組自行定義結構）。
  settings       Json?
  installedAt    DateTime     @default(now())
  /// 安裝者（User.id）。不設 FK，使用者被刪除時保留稽核痕跡。
  installedById  String?
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, moduleKey])
  @@index([organizationId])
}

// ─────────────────────────────────────────────
// 食品標示模組（foodlabel）
// ─────────────────────────────────────────────

/// 輸台商品：一支要從日本進口到台灣的 SKU。
/// 轉換用的規則引擎在 src/lib/foodlabel/（純函式、無 DB 依賴）。
model FoodLabelProduct {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String // 商品名（通常是日文原名）
  nameZh      String? // 中文品名（台灣標示用）
  supplier    String? // 日本供應商 / 製造商
  /// "solid"＝固體（公克）；"liquid"＝液體（毫升）。決定標示用「每100公克」或「每100毫升」。
  state       String  @default("solid")
  servingSize Float? // 每一份量
  packageSize Float? // 包裝總淨重 / 容量

  /// 選填：關聯到 CRM 商機——讓合規缺口能回到業務流程（這支商品是哪一案的交付物）。
  crmDealId String?
  crmDeal   CrmDeal? @relation(fields: [crmDealId], references: [id], onDelete: SetNull)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversions FoodLabelConversion[]

  @@index([organizationId])
  @@index([crmDealId])
}

/// 一次轉換紀錄：日本標示原文 → 台灣營養標示 + 合規檢查結果。
/// 保留原文與完整結果，法規版本改版後可重跑比對。
model FoodLabelConversion {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        FoodLabelProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// 日本營養成分表示原文（貼上或 OCR 結果）。
  sourceText   String @db.Text
  /// 套用的法規版本 id（src/lib/foodlabel/regulations.ts）。
  regulationId String
  /// 完整 ConversionResult（標示列、合規問題、換算過程、未修整數值）。
  resultJson   Json
  errorCount   Int    @default(0)
  warningCount Int    @default(0)

  createdById String?
  createdAt   DateTime @default(now())

  @@index([organizationId])
  @@index([productId])
}
