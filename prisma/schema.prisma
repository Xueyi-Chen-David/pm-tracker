// Project tracker — Prisma schema (Postgres + driver adapter, Prisma 7)
// 本機開發用 Docker Postgres；正式環境把 DATABASE_URL 換成 Neon 即可。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Auth.js (NextAuth v5) — Prisma adapter, database sessions
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String? // 真實姓名
  nickname      String? // 綽號 / 暱稱
  useNickname   Boolean   @default(false) // 顯示時用綽號取代真實姓名
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  // 註：組織內欄位（isBoss / jobTitle / 權限 / 出席追蹤 / profile 文字）已改掛在
  // OrganizationMember 上，讓同一人可在不同組織有不同角色與設定（多租戶隔離）。

  accounts Account[]
  sessions Session[]

  // 組織成員資格（多組織）。
  organizationMemberships OrganizationMember[]

  ownedProjects     Project[]          @relation("ProjectOwner")
  createdProjects   Project[]          @relation("ProjectCreator")
  weeklyUpdates     WeeklyUpdate[]
  activities        Activity[]
  memberEvents      MemberEvent[]
  weeklyTasks       WeeklyTask[]
  attendanceRecords AttendanceRecord[]
  objectivesOwned   Objective[]        @relation("ObjectiveOwner")
  keyResultsOwned   KeyResult[]        @relation("KrOwners")
  tasksOwned        Task[]             @relation("TaskOwners")
  tasksPrimaryOwned Task[]             @relation("TaskPrimaryOwner")

  dailyReports        DailyReport[]
  dailyReportComments DailyReportComment[]
  notifications       Notification[]
  checkIns            CheckIn[]
  trainingAssignments TrainingAssignment[]
  crmContactsOwned    CrmContact[]         @relation("CrmContactOwner")
  crmDealsOwned       CrmDeal[]            @relation("CrmDealOwner")
  todoItems           TodoItem[]
  pomodoroSessions    PomodoroSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// Organizations (多租戶：以「組織 / 公司」為單位)
// ─────────────────────────────────────────────

enum OrgRole {
  OWNER // 擁有者（建立者）
  ADMIN // 管理員（可管理成員）
  MEMBER // 一般成員
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 公司營運頁：組織願景（Vision）。策略層 OKR（年度 / 季度 Objective）掛在下面。
  vision String? @db.Text

  // 每日報告：上級的上級（直屬主管以上的整條鏈）是否也看得到下屬日報。
  // false＝只有直屬主管看得到；true＝整條上級鏈都看得到。由管理者設定。
  dailyReportChainVisible Boolean @default(false)

  // 打卡限制設定（管理者設定）。啟用後，員工需符合「允許 IP」與「地理圍欄」的組合才算有效打卡。
  checkInEnabled    Boolean  @default(false)
  checkInAllowedIps String[] @default([]) // 允許的 IP / CIDR 網段（清單內任一符合即算「網段通過」）
  checkInGeofences  Json? // [{ label, lat, lng, radiusM }]（清單內任一範圍內即算「地點通過」）
  // 網段與地點的組合方式："any"＝任一符合即可（IP 或 地點）；"all"＝兩者皆須符合（IP 且 地點）。
  // 只設定其中一種條件時，兩種模式行為相同（只需該條件通過）。
  checkInMatchMode  String   @default("any")

  members             OrganizationMember[]
  projects            Project[]
  projectViews        ProjectView[]
  weeklyReports       WeeklyReport[]
  reportImages        ReportImage[]
  meetings            Meeting[]
  attendanceRecords   AttendanceRecord[]
  memberEvents        MemberEvent[]
  objectives          Objective[]
  dailyReports        DailyReport[]
  notifications       Notification[]
  checkIns            CheckIn[]
  trainingCourses     TrainingCourse[]
  trainingAssignments TrainingAssignment[]
  trainingDocFolders  TrainingDocFolder[]
  trainingDocPages    TrainingDocPage[]
  crmContacts         CrmContact[]
  crmDeals            CrmDeal[]
  dealStages          DealStage[]
  dealStageChanges    DealStageChange[]
  crmEvents           CrmEvent[]
  todoItems           TodoItem[]
  pomodoroSessions    PomodoroSession[]
}

/**
 * 組織成員。以 email 為邀請鍵（可在該人登入前先建立），userId 連到全域 User。
 * 「組織內」欄位（角色 / 職稱 / 老闆 / 權限 / 出席追蹤 / 團隊 profile）都掛在這裡，
 * 讓同一人在不同組織可有不同設定。
 */
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String // 邀請鍵（小寫）＝該 User 的 email
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(MEMBER)

  // ── 從 User 搬過來的「組織內」欄位 ──
  jobTitle        String? // 職稱（顯示用）
  department      String? // 部門（顯示 / 分組用；組織架構頁可就地設定）
  isBoss          Boolean  @default(false) // 老闆：週報「需要決策」收件對象
  active          Boolean  @default(true) // 是否在職 / 啟用（於此組織）
  allowedModules  String[] @default([]) // 細分權限：空陣列＝可見全部；非空＝只可見列出的模組
  trackAttendance Boolean  @default(false) // 是否納入出席月曆追蹤
  bio             String?  @db.Text // 簡介 / 備註
  attendance      String? // 出席情況（自由文字）
  workDescription String?  @db.Text // 工作描述（本人可改，管理者可改任何人的）

  // 組織架構：上級主管（指向同組織的另一位成員）。主管可看下屬的每日報告。
  managerId String?
  manager   OrganizationMember?  @relation("MemberManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   OrganizationMember[] @relation("MemberManager")

  // 額外（虛線 / 矩陣式）回報對象：除 managerId 外，也回報給這些成員（值＝membership id）。
  // 這些人與正式上級主管一樣，可在每日報告看到並回饋這位成員的日報，但可見性不沿其
  // 自身主管鏈往上傳遞。純 id 陣列（無 FK）；成員被移除時由 deleteWorkspaceMember 清掉殘留 id。
  secondaryManagerIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([managerId])
}

// ─────────────────────────────────────────────
// Domain models
// ─────────────────────────────────────────────

enum ProjectType {
  ROUTINE // 常態型任務
  PROJECT // 專案型任務
  ONE_TIME // 一次型任務
}

enum ProjectStatus {
  NOT_STARTED // 未開始
  ACTIVE // 進行中
  ON_HOLD // 暫停
  COMPLETED // 已完成
  CANCELLED // 已取消
}

// RAG 紅黃綠燈 — 一眼看出問題（業界週報慣例）
enum Health {
  GREEN // 順利
  YELLOW // 需注意
  RED // 有阻礙/落後
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MilestoneStatus {
  PLANNED // 規劃中
  IN_PROGRESS // 進行中
  DONE // 已完成
  MISSED // 已逾期/未達成
}

model Project {
  id          String        @id @default(cuid())
  name        String
  type        ProjectType   @default(PROJECT)
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  health      Health        @default(GREEN) // 目前健康度（可由最新週報帶入）
  priority    Priority      @default(MEDIUM)

  startDate     DateTime? // 開始日
  targetDate    DateTime? // 理想完成日（planned）
  actualEndDate DateTime? // 實際完成日

  progress  Int     @default(0) // 目前整體進度 0-100
  color     String? // timeline / 標籤顏色（hex）
  archived  Boolean @default(false)
  sortOrder Int     @default(0)

  countInProgress Boolean @default(true) // 是否計入週報「完成度」統計（整體平均進度）

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id])

  createdById String
  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id])

  weeklyUpdates WeeklyUpdate[]
  milestones    Milestone[]
  releases      ProjectRelease[]
  activities    Activity[]
  keyResults    KeyResult[]      @relation("KrProject")
  tasks         Task[]           @relation("ProjectTask")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([status])
}

model WeeklyUpdate {
  id        String   @id @default(cuid())
  projectId String
  weekStart DateTime @db.Date // 該週週一（唯一鍵，用於去重 / 排序）

  progress      Int     @default(0) // 該週整體進度 0-100
  health        Health  @default(GREEN) // 該週狀態（RAG）
  thisWeekGoals String? @db.Text // 本週目標
  thisWeekDone  String? @db.Text // 本週完成
  nextWeekGoals String? @db.Text // 下週目標
  risks         String? @db.Text // 風險 / 阻礙
  needsDecision String? @db.Text // 需要老闆決策（空＝無）
  note          String? @db.Text // 其他備註

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  tasks WeeklyTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, weekStart])
  @@index([weekStart])
}

/// 每週進度紀錄下的具體任務，可指定負責人。
model WeeklyTask {
  id             String       @id @default(cuid())
  weeklyUpdateId String
  weeklyUpdate   WeeklyUpdate @relation(fields: [weeklyUpdateId], references: [id], onDelete: Cascade)
  title          String
  done           Boolean      @default(false)
  assigneeId     String?
  assignee       User?        @relation(fields: [assigneeId], references: [id])
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([weeklyUpdateId])
}

// 版本發布狀態（changelog）：規劃中 / 已發布。
enum ReleaseStatus {
  PLANNED // 規劃中 / 未發布
  RELEASED // 已發布
}

/**
 * 專案版本發布紀錄（changelog）。依 Keep a Changelog + SemVer 慣例：每筆一個版本號、
 * 發布日期、狀態與變更說明（notes 支援 Markdown）。最新版本顯示在專案摘要 Hero。
 */
model ProjectRelease {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version    String // 版本號，如 v1.2.0
  title      String? // 摘要標題（選填）
  notes      String?       @db.Text // 變更說明（Markdown）
  status     ReleaseStatus @default(RELEASED)
  releasedAt DateTime?     @db.Date // 發布日（規劃中可空）

  sortOrder   Int      @default(0)
  createdById String? // 建立者（顯示用，不設關聯）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model Milestone {
  id        String          @id @default(cuid())
  projectId String
  title     String
  detail    String?         @db.Text
  status    MilestoneStatus @default(PLANNED)

  plannedDate DateTime? @db.Date // 理想時程
  actualDate  DateTime? @db.Date // 實際達成時程

  isGoal    Boolean @default(false) // 設為「目標」（vs 一般里程碑）
  sortOrder Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// 操作紀錄的種類（決定圖示 / 篩選；NOTE＝使用者手動備註）
enum ActivityKind {
  CREATE // 建立專案
  STATUS // 狀態變更
  HEALTH // 健康度變更
  PROGRESS // 進度變更
  FIELD // 一般欄位編輯
  MILESTONE // 里程碑變更
  MEMBER // 成員變更
  WEEKLY // 週報變更
  RELEASE // 版本發布變更
  ARCHIVE // 封存 / 取消封存
  NOTE // 使用者手動備註
}

/**
 * 專案操作紀錄（活動軌跡）。系統在各動作後自動寫入；使用者亦可手動新增備註（kind=NOTE）。
 * 任何一筆都可被刪除（內部團隊工具）。
 */
model Activity {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      ActivityKind @default(NOTE)
  message   String       @db.Text // 顯示文字（如「狀態：進行中 → 已完成」）
  userId    String? // 操作者（手動備註必有；系統動作通常有）
  user      User?        @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([projectId, createdAt])
}

/**
 * 專案清單的「視窗 / 分頁」。「全體」為系統視窗（isSystem，不可刪），其餘可自由新增/刪除。
 * 每個視窗用 status / type 篩選專案（null＝不限）。
 */
model ProjectView {
  id        String          @id @default(cuid())
  name      String
  /**
   * 篩選條件：狀態 / 類型（空陣列＝不限）。
   */
  statuses  ProjectStatus[]
  types     ProjectType[]
  /**
   * true＝反向：顯示「不符合」上述條件的專案（排除某些）。
   */
  exclude   Boolean         @default(false)
  isSystem  Boolean         @default(false) // 「全體」＝true，不可刪除
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// 每週週報的「整體說明」自由文字（每週一筆，依週一日期為唯一鍵）。
model WeeklyReport {
  id          String   @id @default(cuid())
  weekStart   DateTime @db.Date
  summary     String   @db.Text // 純文字鏡像（不含圖片 raw data，給 log / 純文字情境）
  contentHtml String?  @db.Text // 文件內文（像 doc/email，文字與內嵌圖片在一起）
  images      String[] // 舊版圖片欄位（保留相容）
  content     Json? // 舊版區塊（保留相容）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, weekStart])
}

/// 週報內文的圖片（以二進位存，內文只引用短網址，base64 不會流經 action / log）。
model ReportImage {
  id        String   @id @default(cuid())
  data      Bytes
  mime      String   @default("image/jpeg")
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// 會議記錄（全體會議 / 研發部會議 等）。依日期歸入對應週、顯示在該週週報。
model Meeting {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  category    String // 例：全體會議 / 研發部會議
  title       String
  attendeeIds String[] // 與會成員（User id；「全體」＝全部成員）
  attendees   String?  @db.Text // 其他與會者（非系統成員，自由文字）
  link        String?  @db.Text // 會議連結（Google Meet / 會議文件…；可能很長）
  notes       String?  @db.Text // 會議記錄 / 決議
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([date])
}

/// 每日出席紀錄（每人每日最多一筆；present=有出席，false=缺席）。
/// 只追蹤 User.trackAttendance = true 的成員，供出席月曆一眼檢視。
model AttendanceRecord {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  present     Boolean    @default(true) // true=出席 / false=缺席（offsite 時 present 不看，另以圈圈呈現）
  reason      String? // 事由（請假 / 出差 / 在家工作…；選填）
  offsite     Boolean    @default(false) // 出差 / 在家工作（在外工作）：出席月曆顯示為圈圈
  holiday     Boolean    @default(false) // 休假 / 放假：既不算出席也不算缺席（週末預設放假不寫入，這是人工指定的休）
  leave       Boolean    @default(false) // 請假（特休 / 事假 / 病假…）：既不算出席也不算缺席，事由記在 reason
  auto        Boolean    @default(false) // 由成員事件自動產生（vs 人工登記）；人工編輯會清為 false
  createdById String? // 登記者
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, date])
  @@index([organizationId])
  @@index([date])
}

/// 成員事件（請假 / 出差 / 在家工作 等），記在個人 profile。
model MemberEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // 請假 / 出差 / 在家工作 / 外出 / 其他
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date // 範圍結束（null＝單日）
  note        String?   @db.Text
  createdById String?
  createdAt   DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId, startDate])
}

// ─────────────────────────────────────────────
// OKR（目標與關鍵成果）
// OKR 是「即時鏡子」：Objective 依季別分組 KR；KR 可連到一個 Project，
// 連上後其狀態/進度/健康度改讀專案當下值（不落庫），未連的才手動填。
// ─────────────────────────────────────────────

enum KrStatus {
  NOT_STARTED // 未開始
  IN_PROGRESS // 進行中
  DONE // 已完成
  BLOCKED // 延宕 / 卡住
  CANCELLED // 取消
}

// 策略層 OKR 的層級：年度 / 季度（公司營運頁分兩區呈現）。
enum OkrLevel {
  ANNUAL // 年度 OKR（cycle＝年份，如 "2026"）
  QUARTERLY // 季度 OKR（cycle＝季別，如 "2026 Q3"）
}

/// 目標（Objective）＝公司營運頁的策略層 OKR。依組織 + 層級(level) + 週期(cycle) 分組，底下掛多條 KeyResult。
model Objective {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  level       OkrLevel  @default(QUARTERLY) // 年度 / 季度
  cycle       String // 週期：年度＝年份 "2026"；季度＝"2026 Q3"
  targetDate  DateTime? @db.Date // 目標日期（7/10、8月底…）
  sortOrder   Int       @default(0)
  archived    Boolean   @default(false)

  ownerId String?
  owner   User?   @relation("ObjectiveOwner", fields: [ownerId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  keyResults KeyResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, cycle])
}

/// 關鍵成果（Key Result）。連到 Project 時＝即時鏡子（狀態/進度讀專案）；
/// 未連時用自身 status/progress/health（供非專案的檢查點：律師看過合約、名片…）。
model KeyResult {
  id          String    @id @default(cuid())
  objectiveId String
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  title       String
  kind        String    @default("kr") // "kr" | "todo"

  // 連到專案（可選）＝即時抓專案當下狀態；null＝手動。
  projectId String?
  project   Project? @relation("KrProject", fields: [projectId], references: [id], onDelete: SetNull)

  // 手動 KR 用（連了專案就改讀專案的，這些被忽略）。
  status   KrStatus  @default(NOT_STARTED)
  health   Health    @default(GREEN)
  progress Int       @default(0) // 0-100
  note     String?   @db.Text // 這週目標 / 備註
  dueDate  DateTime? @db.Date

  owners     User[]  @relation("KrOwners") // 多負責人（組織成員）
  ownerLabel String? // 外部非成員自由文字（律師 Also…）

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objectiveId])
  @@index([projectId])
}

/// 任務（Task）＝合併「專案與任務」頁裡，掛在某專案卡片下的一列。
/// 專案卡片的彙總進度/健康度由底下任務即時算出並回寫到 Project（供時程/週報/連動 KR 共用）。
model Task {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation("ProjectTask", fields: [projectId], references: [id], onDelete: Cascade)
  title     String

  status    KrStatus  @default(NOT_STARTED)
  health    Health    @default(GREEN)
  progress  Int       @default(0) // 0-100
  note      String?   @db.Text // 這週目標 / 備註
  startDate DateTime? @db.Date // 開始日
  dueDate   DateTime? @db.Date // 結束 / 到期日

  // 到期提醒：到期日「前 N 天」提醒（天數自由設定，可多個，如 [7,3,1]）。
  // 每日 cron 依此發站內通知給任務負責人。空＝不提醒。
  reminderDays Int[] @default([])

  owners     User[]  @relation("TaskOwners") // 多負責人（組織成員）
  ownerLabel String? // 外部非成員自由文字

  // 主負責人：owners 之中被指定為「主要負責」的一位（可空）。移除該負責人時一併清除。
  primaryOwnerId String?
  primaryOwner   User?   @relation("TaskPrimaryOwner", fields: [primaryOwnerId], references: [id], onDelete: SetNull)

  todoItems TodoItem[] // 個人待辦可關聯到此任務

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ─────────────────────────────────────────────
// 每日報告（Daily report）— 每人每日一筆，量化自評 + 短備註。
// 只有作者本人與其上級主管（依組織設定決定是否含更上層）看得到。
// ─────────────────────────────────────────────

model DailyReport {
  id    String   @id @default(cuid())
  date  DateTime @db.Date // 報告日（UTC 午夜；每人每日唯一）
  score Int      @default(0) // 自評完成度 0–100（量化）
  note  String? // 今日重點（≤50 字，於 action 驗證）

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  comments DailyReportComment[]
  items    DailyReportItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId, date])
  @@index([organizationId, date])
  @@index([userId, date])
}

/// 每日報告底下的工作項目（陳宗賢式：計畫 vs 實績量化）。
/// 每項有目標數量與實際完成數量，達成率＝實際/目標；日報 score 由各項達成率平均得出。
model DailyReportItem {
  id       String      @id @default(cuid())
  reportId String
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  title  String // 任務 / 工作項目
  unit   String? // 單位（件 / 通 / % …），選填
  target Float   @default(0) // 目標數量（分母）
  actual Float   @default(0) // 實際完成數量（分子）

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reportId])
}

/// 每日報告的留言（主管回饋）。新增後會通知報告作者。
model DailyReportComment {
  id        String      @id @default(cuid())
  reportId  String
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String      @db.Text
  createdAt DateTime    @default(now())

  @@index([reportId])
}

/// 站內通知（例：主管回饋你的每日報告）。read=已讀。
model Notification {
  id        String   @id @default(cuid())
  userId    String // 收件者
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 例：daily_comment
  title     String
  body      String?  @db.Text
  link      String? // 點擊前往的頁面
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([organizationId])
}

/// 打卡紀錄（上班 / 下班）。valid=通過 IP / 地理圍欄驗證。有效上班打卡會標記當日出席。
model CheckIn {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date // 打卡日（供每日聚合）
  at     DateTime @default(now()) // 實際打卡時間
  kind   String // "in"（上班）/ "out"（下班）
  method String? // 通過方式："ip" / "gps"（valid=false 時為 null）
  valid  Boolean  @default(false)
  ip     String?
  lat    Float?
  lng    Float?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@index([userId, date])
}

// ─────────────────────────────────────────────
// 員工教育訓練（Training）— 課程目錄 + 指派給成員 + 完成追蹤。
// 必修（法遵）可設有效月數，完成後到期需重訓；支援分類、教材連結、預估時數。
// ─────────────────────────────────────────────

enum TrainingFormat {
  ONLINE // 線上課程
  VIDEO // 影片
  DOCUMENT // 文件 / 閱讀
  IN_PERSON // 實體 / 講座
  EXTERNAL // 外部課程 / 認證
}

enum TrainingStatus {
  NOT_STARTED // 未開始
  IN_PROGRESS // 進行中
  COMPLETED // 已完成
}

/// 訓練課程（課程目錄；由管理者建立、指派給成員）。
model TrainingCourse {
  id           String         @id @default(cuid())
  title        String
  description  String?        @db.Text
  category     String         @default("一般") // 新人訓練 / 法遵 / 專業技能 / 職場安全 / 一般
  format       TrainingFormat @default(ONLINE)
  resourceUrl  String? // 教材 / 課程連結
  estimatedMin Int? // 預估時數（分鐘）
  required     Boolean        @default(false) // 必修（法遵 / 強制）
  renewMonths  Int? // 有效月數（完成後幾個月需重訓；null＝永久）
  active       Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignments TrainingAssignment[]

  @@index([organizationId])
}

/// 課程指派（每位成員每門課一筆）＝該員的訓練紀錄（狀態 / 到期日 / 完成日 / 分數）。
model TrainingAssignment {
  id           String         @id @default(cuid())
  courseId     String
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       TrainingStatus @default(NOT_STARTED)
  dueDate      DateTime?      @db.Date // 應完成日
  startedAt    DateTime?
  completedAt  DateTime?
  score        Int? // 測驗分數（選填 0–100）
  note         String?        @db.Text
  assignedById String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([organizationId])
  @@index([userId, status])
  @@index([courseId])
}

// ─────────────────────────────────────────────
// 員工教育訓練文件庫（Training Docs）— 巢狀資料夾 + markdown 文件。
// 取代原本的「課程指派 / 完成追蹤」，改成內部知識庫 / wiki 形式：
// 資料夾可多層巢狀（parentId 自參照），最底層是可用 markdown 編輯的文件（TrainingDocPage）。
// 資料夾 / 文件皆可自由新增命名。管理者(OWNER/ADMIN)編輯，組織成員皆可讀 + 搜尋。
// ─────────────────────────────────────────────

/// 文件資料夾（可多層巢狀）。刪除資料夾會連同子資料夾與其中文件一併移除（DB 層級聯串）。
model TrainingDocFolder {
  id             String       @id @default(cuid())
  name           String
  sortOrder      Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // 自參照樹狀結構：parentId 為 null＝根層資料夾。
  parentId String?
  parent   TrainingDocFolder?  @relation("DocFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TrainingDocFolder[] @relation("DocFolderTree")

  pages TrainingDocPage[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([parentId])
}

/// 文件（樹葉節點）：內容以 markdown 純文字儲存。folderId 為 null＝放在根層。
model TrainingDocPage {
  id        String @id @default(cuid())
  title     String
  content   String @default("") @db.Text // markdown 原文
  sortOrder Int    @default(0)

  // 可見性：ALL＝所有人可見（預設）；RESTRICTED＝僅 allowedUserIds 內的人可見。
  // 管理者(OWNER/ADMIN/老闆)一律可見，不受此限制。
  visibility     String   @default("ALL")
  allowedUserIds String[] @default([]) // RESTRICTED 時的白名單（user id）
  // 編輯白名單：除了管理者(OWNER/ADMIN)一律可編輯外，額外可編輯這份文件的成員 user id。
  editorUserIds  String[] @default([])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  folderId String?
  folder   TrainingDocFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([folderId])
}

// ─────────────────────────────────────────────
// CRM（客戶關係管理）：聯絡人 + 商機銷售管線 + 活動時間軸
// 業界慣例：以「管線階段(stage)」推進商機；成交/流失後離開管線。org-scoped。
// ─────────────────────────────────────────────

enum CrmDealStatus {
  OPEN // 進行中（在管線上）
  WON // 成交
  LOST // 流失
}

/// 聯絡人 / 客戶（公司或個人）。
model CrmContact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String // 主要聯絡人姓名
  company String? // 公司名稱
  title   String? // 職稱
  email   String?
  phone   String?
  note    String? @db.Text

  ownerId     String?
  owner       User?   @relation("CrmContactOwner", fields: [ownerId], references: [id])
  createdById String?

  deals  CrmDeal[]
  events CrmEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// 商機 / 交易（銷售管線的一張卡）。
model CrmDeal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title  String
  value  Int           @default(0) // 金額（日圓，整數）
  stage  String        @default("LEAD") // DealStage.key（每組織可自訂階段）
  status CrmDealStatus @default(OPEN)

  contactId String?
  contact   CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("CrmDealOwner", fields: [ownerId], references: [id])

  expectedCloseDate DateTime? @db.Date // 預計成交日
  closedAt          DateTime? // 成交 / 流失時間
  note              String?   @db.Text
  sortOrder         Int       @default(0) // 同一階段內排序
  createdById       String?

  activities   CrmActivity[]
  stageChanges DealStageChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([contactId])
  @@index([organizationId, stage])
}

/// 每組織可自訂的銷售管線階段（看板欄位）。key 為穩定鍵，CrmDeal.stage 存 key。
model DealStage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key       String // 穩定鍵：預設階段用語意鍵（LEAD…），自訂為 cuid
  label     String // 顯示名稱（可編輯）
  note      String? @db.Text // 小備註（顯示於欄位上方）
  color     String  @default("slate") // 色名（slate/sky/cyan/violet/amber/emerald/rose/zinc…）
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

/// 商機的階段異動時間線（每次換階段記一筆，含原因），供視覺化客戶狀態歷程。
model DealStageChange {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dealId String
  deal   CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  fromStage String? // 前一階段 key（建立商機時為 null）
  toStage   String // 新階段 key
  reason    String? @db.Text // 這次調整的原因

  changedById String?
  changedAt   DateTime @default(now())

  @@index([dealId, changedAt])
  @@index([organizationId])
}

/// 商機的活動 / 備註時間軸（電話 / 會議 / Email / 備註 / 待辦）。
model CrmActivity {
  id     String  @id @default(cuid())
  dealId String
  deal   CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  type    String    @default("note") // note | call | email | meeting | task
  body    String    @db.Text
  dueDate DateTime? @db.Date // task 用（跟進提醒）
  done    Boolean   @default(false)

  createdById String?
  createdAt   DateTime @default(now())

  @@index([dealId])
}

/// CRM 活動紀錄（org-scoped，獨立於商機）：以類似會議記錄的方式記錄拜訪 / 電話 /
/// 活動 / Email 等，含日期、類型、主題、內容與可選連結。
model CrmEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  date  DateTime @db.Date
  type  String   @default("活動") // 拜訪 / 電話 / 活動 / Email / 會議 / 其他
  title String
  notes String?  @db.Text
  link  String?  @db.Text // 可選連結（可能很長）

  // 可選：關聯到某個客戶（聯絡人）。
  contactId String?
  contact   CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([date])
  @@index([contactId])
}

// ─────────────────────────────────────────────
// 個人待辦（Todo）+ 番茄鐘（Pomodoro）——每個人自己管理，不與他人共享。
// ─────────────────────────────────────────────

/// 個人待辦事項。可選擇性關聯到某個專案任務(Task)；有開始 / 結束日。
model TodoItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title String
  note  String? @db.Text // 備註（選填，自由文字）
  done  Boolean @default(false)

  startDate DateTime? @db.Date // 開始日
  dueDate   DateTime? @db.Date // 結束 / 到期日

  // 關聯到的專案任務（可選；任務被刪則設為 null 不連帶刪待辦）。
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pomodoros PomodoroSession[]

  @@index([userId])
  @@index([organizationId])
  @@index([taskId])
}

/// 番茄鐘專注紀錄。durationSec＝該次專注秒數；可選擇性關聯到某個待辦。
model PomodoroSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  todoId String?
  todo   TodoItem? @relation(fields: [todoId], references: [id], onDelete: SetNull)

  startedAt   DateTime @default(now()) // 開始專注的時間
  durationSec Int // 專注時長（秒）
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([todoId])
}

